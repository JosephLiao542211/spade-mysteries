# Unreal generated folders
Binaries/
Intermediate/
Saved/
DerivedDataCache/
Plugins/**/Binaries/
Plugins/**/Intermediate/

# Build folder: keep platform config/icons, ignore generated output
Build/**/Intermediate/
Build/**/Binaries/
Build/Receipts/

# IDE / project files (regenerated by Unreal)
*.xcworkspace
*.xcodeproj
.vs/
.vscode/
.idea/
*.sln
*.code-workspace

# Misc
.DS_Store
*.bak
*.tmp
*.log

# Local LLM: fetched by Tools/fetch-models.ps1, never committed (GitHub LFS caps files at 2 GB)
Models/
*.gguf
ThirdParty/llama/

# Python bytecode
__pycache__/
